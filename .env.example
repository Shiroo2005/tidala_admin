VITE_PUBLIC_SITE_URL=https://tidala.vn
# Real backend for login, tags, training levels and provinces (default shown).
VITE_API_BASE_URL=https://dev-v2-api.tidala.vn
# Prefix for backend image object keys (default shown).
VITE_IMAGE_URL_PREFIX=https://cdn-dev.tidala.vn
# Set to true to let anyone open the admin without signing in (never in production).
VITE_DISABLE_AUTH=false
